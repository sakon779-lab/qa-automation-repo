{
  "gates": [
    {
      "name": "node_demo-e2e",
      "run": "npx playwright test --config tests/node_demo/playwright.config.ts",
      "if_exists": "tests/node_demo/playwright.config.ts"
    },
    {
      "name": "node_demo_mobile-e2e",
      "run": "node -e \"require('fs').mkdirSync('results/maestro/shots',{recursive:true})\" && maestro test tests/node_demo_mobile --format junit --output results/maestro/node_demo_mobile.xml",
      "if_exists": "tests/node_demo_mobile/config.yaml",
      "when_changed": "tests/node_demo_mobile/",
      "timeout_s": 1200
    }
  ],
  "visual": [
    {
      "name": "node_demo-visual",
      "shots": "results/playwright/shots",
      "baselines": "baselines/node_demo",
      "threshold": 0.01
    },
    {
      "name": "node_demo_mobile-visual",
      "shots": "results/maestro/shots",
      "baselines": "baselines/node_demo_mobile",
      "threshold": 0.01
    }
  ]
}
